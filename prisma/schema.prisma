// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/dev.db"
}

model Property {
  id          String   @id @default(cuid())
  name        String   // ex: "Appartement Centre"
  address     String
  postalCode  String
  city        String
  type        String   @default("Appartement") // Appartement, Maison, Parking

  // Caractéristiques exigées par l'attestation de loyer CAF (Cerfa 10842*07)
  surface     Float?   // Surface réelle en m²
  furnished   Boolean  @default(false) // Loué meublé
  singleRoom  Boolean  @default(false) // Chambre (pièce unique sans WC)

  tenants     Tenant[]
  expenses    Expense[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Charge décaissée par le bailleur, déductible au régime réel.
/// La catégorie est une chaîne validée par EXPENSE_CATEGORIES (src/lib/expenses.ts),
/// même approche que Payment.typology.
model Expense {
  id          String   @id @default(cuid())
  category    String   // cf. EXPENSE_CATEGORIES
  label       String
  amount      Float
  date        DateTime // Date de décaissement : le BIC est une comptabilité de caisse

  // Facultatif : la CFE, les honoraires comptables ou les frais bancaires ne se
  // rattachent pas à un bien en particulier. La suppression d'un bien remet ce
  // champ à null (la charge bascule en « Non affecté ») plutôt que d'effacer une
  // charge déjà déduite.
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])

  note        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([propertyId])
  @@index([category])
}

model Tenant {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  
  // Champs adressés conservés pour l'historique ou si pas de bien lié
  address     String   
  postalCode  String
  city        String
  
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])

  rentAmount  Float    // Loyer hors charges
  chargeAmount Float   // Charges provisionnelles
  startDate   DateTime // Date d'entrée
  endDate     DateTime?

  payments    Payment[]
  signatureRequests SignatureRequest[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
  @@index([endDate])
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  periodStart DateTime
  periodEnd   DateTime
  
  amount      Float    // Montant total payé
  date        DateTime // Date de paiement
  
  typology    String   @default("Loyer") // Loyer, CAF, Regularisation, Depot

  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, periodStart])
  @@index([date])
}

model SignatureRequest {
  id          String   @id @default(cuid())
  externalId  String?  @unique // ID côté Yousign
  status      String   @default("PENDING") // PENDING, SIGNED, REJECTED, EXPIRED
  documentUrl String?  // URL du document signé
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model Landlord {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  address     String?
  city        String?
  postalCode  String?
  siret       String?
  companyName String? // Si SCI ou Société
  
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER") // ADMIN, USER

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
