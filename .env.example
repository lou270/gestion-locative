# --- Authentification -------------------------------------------------------
# Chaîne aléatoire longue. Génération : openssl rand -base64 32
AUTH_SECRET="change-me"
# Compte administrateur créé/mis à jour par `npx prisma db seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
# Nécessaire derrière un reverse proxy (Docker, Nginx…)
AUTH_TRUST_HOST=true

# --- Base de données --------------------------------------------------------
# L'URL est aussi codée dans prisma/schema.prisma ; utile pour la CLI Prisma.
DATABASE_URL="file:../data/dev.db"

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Signature électronique (Yousign, optionnel) ----------------------------
YOUSIGN_API_KEY=""
YOUSIGN_API_URL="https://api-sandbox.yousign.app/v3"
# OBLIGATOIRE si vous utilisez les webhooks : sans ce secret, /api/webhooks/yousign
# rejette toutes les requêtes (un endpoint public non signé permettrait à
# n'importe qui de marquer un bail comme signé).
YOUSIGN_WEBHOOK_SECRET=""

# --- Déploiement Docker ------------------------------------------------------
# Le conteneur tourne sous cet utilisateur et doit posséder le dossier ./data.
# Vérifiez le vôtre avec `id -u` / `id -g` ; 1000 convient dans la plupart des cas.
APP_UID=1000
APP_GID=1000
